# Copy to backend/.env. Never put tokens in web/ or VITE_* variables.
OPENROUTER_API_TOKEN=
# OpenRouter IDs exactly as supplied. Rates optional, USD / million tokens.
JOE_MODELS_JSON=[{"id":"openai/gpt-6-luna","label":"GPT-6 Luna"},{"id":"openai/gpt-5.6-luna","label":"GPT-5.6 Luna"},{"id":"anthropic/claude-sonnet-5.5","label":"Claude Sonnet 5.5"},{"id":"anthropic/claude-haiku-5.5","label":"Claude Haiku 5.5"}]
# Example shape: [{"id":"provider/model","label":"My model","inputPerMillion":1,"outputPerMillion":2}]
FISH_API_TOKEN=
# Legacy voice ID is used for English when _EN is empty.
FISH_REFERENCE_ID=
FISH_REFERENCE_ID_EN=
FISH_REFERENCE_ID_ZH=
FISH_TTS_MODEL=s2.1-pro
FISH_ASR_MODEL=transcribe-1
# Optional estimated rates. Leave empty for unknown, not zero.
FISH_ASR_USD_PER_MINUTE=
FISH_TTS_USD_PER_MILLION_CHARS=
JOE_DATA_DIR=./data
JOE_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional external tool contract: POST {query,limit} -> {sources:[{title,url,content}]}
ZENDOCS_SEARCH_URL=
ZENDOCS_TOKEN=

# Voice provider: fish | elevenlabs. Optional per-capability overrides.
JOE_VOICE_PROVIDER=fish
JOE_ASR_PROVIDER=
JOE_TTS_PROVIDER=
ELEVENLABS_API_KEY=
# English and Chinese profiles bind language to a specific voice ID.
# Legacy ELEVENLABS_VOICE_ID is the English fallback only.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ZH=
ELEVENLABS_ASR_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional estimates in USD. Unknown duration/cost remains pending.
ELEVENLABS_ASR_USD_PER_MINUTE=
ELEVENLABS_TTS_USD_PER_MILLION_CHARS=

# WeatherAPI.com key: https://www.weatherapi.com/my/
WEATHER_API_KEY=
